{
  "name": "sadik-sons-enterprises",
  "productName": "Sadik Sons Enterprises",
  "version": "1.0.0",
  "description": "Sadik Sons Enterprises — Office Management Suite",
  "main": "main.cjs",
  "author": "Sadik Sons Enterprises",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.sadiksons.enterprises",
    "productName": "Sadik Sons Enterprises",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server.cjs",
      "db.cjs",
      "cloudSync.cjs",
      "config.json",
      "index.html",
      "app.js",
      "qrcode.min.js",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sadik Sons Enterprises"
    }
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  }
}
